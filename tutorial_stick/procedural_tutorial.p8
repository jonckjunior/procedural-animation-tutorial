pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include euler.lua
#include verlet.lua

function _init()
    eps = 0.01
    radius = 3
    point_y = 10
    y_delta = 30
    -- use radius in euler and verlet
    add_euler_particle(40, point_y)
    add_euler_particle(40, point_y + y_delta)
    add_verlet_particle(80, point_y)
    add_verlet_particle(80, point_y + y_delta)
end

function _update()
    update_euler_system()
    update_verlet_system()
end

function _draw()
    cls()
    -- draw borders
    line(127 / 2, 0, 127 / 2, 127, 5)
    line(0, 0, 127, 0, 5)
    line(0, 127, 127, 127, 5)
    line(0, 0, 0, 127, 5)
    line(127, 0, 127, 127, 5)

    draw_euler()
    draw_verlet()
    print("euler", 5, 5, 8)
    print("verlet", 70, 5, 12)
end

__gfx__
