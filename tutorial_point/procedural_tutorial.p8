pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include euler.lua
#include verlet.lua

function _init()
end

function _update()
    update_euler(euler_p)
    update_verlet(verlet_p)
end

function _draw()
    cls()
    line(127 / 2, 0, 127 / 2, 127, 5)
    line(0, 0, 127, 0, 5)
    line(0, 127, 127, 127, 5)
    line(0, 0, 0, 127, 5)
    line(127, 0, 127, 127, 5)

    draw_euler()
    draw_verlet()
    print("euler", 5, 5, 8)
    print("verlet", 70, 5, 12)
end

